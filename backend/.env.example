# Ulaşım Bakım Yönetim Sistemi - yapılandırma ŞABLONU
# Bu dosyayı "backend/.env" olarak kopyalayıp kendi gerçek değerlerinizi
# girin. Gerçek backend/.env dosyası .gitignore'dadır — hiçbir zaman
# git'e eklenmez/pushlanmaz, sırlar bu şekilde repo dışında kalır.

# JWT imzalama anahtarı - ÜRETİMDE MUTLAKA DEĞİŞTİRİN (uzun, rastgele bir
# değer). Üretmek için: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=degistir-bu-anahtari-uretimde

# Veritabanı bağlantısı
# Varsayılan: SQLite (backend klasöründe ulasim_bakim.db oluşturur)
DATABASE_URL=sqlite:///./ulasim_bakim.db

# PostgreSQL için üstteki satırı silin ve şunu kullanın:
# DATABASE_URL=postgresql+psycopg2://kullanici:sifre@sunucu:5432/ulasim_bakim

# E-posta doğrulama / şifremi unuttum kodları için SMTP ayarları (Gmail
# kullanıyorsanız SMTP_PASSWORD normal şifreniz DEĞİL, bir "Uygulama Şifresi"
# olmalı: Google Hesabı > Güvenlik > 2 Adımlı Doğrulama > Uygulama Şifreleri)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ornek@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=ornek@gmail.com
