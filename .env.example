# docker-compose.yml tarafından okunan SUNUCUYA ÖZEL ayarlar (backend/.env
# ile KARIŞTIRMAYIN — o dosya uygulama sırlarını/SMTP ayarlarını tutar, bu
# dosya ise yalnızca "docker compose"un kendisinin kullandığı değerleri).
#
# Kullanmak için bu dosyayı ".env" adıyla kopyalayın:
#   cp .env.example .env
# ve APP_PORT'u düzenleyin.

# Bu uygulamanın (Ulaşım Bakım) sunucudaki HOST portu. Aynı sunucuda başka
# projeler de (ör. "datalogger") çalışıyorsa, HER PROJE FARKLI bir APP_PORT
# kullanmalı — aksi halde "port zaten kullanımda" hatasıyla ikisi birden
# ayakta duramaz. Örnek: ulasim-bakim=8001, datalogger=8002.
APP_PORT=8001
